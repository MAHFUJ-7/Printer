generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PRINTER_OWNER
  ADMIN
}

enum PrinterStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LedgerType {
  DEBIT
  CREDIT
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  username     String         @unique
  password     String
  firstName    String?        @map("first_name")
  lastName     String?        @map("last_name")
  role         UserRole       @default(STUDENT)
  balance      Decimal        @default(0.00) @db.Decimal(10, 2)
  isVerified   Boolean        @default(false) @map("is_verified")
  printers     Printer[]
  printJobs    PrintJob[]
  creditLedger CreditLedger[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Printer {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  location     String
  model        String
  capabilities Json
  pricePerPage Decimal       @map("price_per_page") @db.Decimal(10, 2)
  priceColor   Decimal?      @map("price_color") @db.Decimal(10, 2)
  status       PrinterStatus @default(OFFLINE)
  printJobs    PrintJob[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([location])
  @@map("printers")
}

model PrintJob {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  printerId String    @map("printer_id") @db.Uuid
  printer   Printer   @relation(fields: [printerId], references: [id], onDelete: Restrict)
  fileUrl   String    @map("file_url")
  pageCount Int       @map("page_count")
  isColor   Boolean   @default(false) @map("is_color")
  totalCost Decimal   @map("total_cost") @db.Decimal(10, 2)
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([printerId])
  @@index([status])
  @@map("print_jobs")
}

model CreditLedger {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal    @db.Decimal(10, 2)
  type        LedgerType
  description String
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("credit_ledger")
}
